{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "MediaDrive": "d:\\medias",
    "MediaRequestPath": "/medias",
    "PathBase": "/webdownload",
    "DownloadHubPath": "/downloadHub",
    "SplitterHubPath": "/splitterHub",
    "VoiceSwapHubPath": "/voiceSwapHub",
    "ConvertHubPath": "/convertHub"
  },
  "MediaMenu": {
    "Titles": { "rpm": "រស្មីពានមាស" },
    //"musics": "Musics",
    "Order": [],
    "CacheSeconds": 60
  },
  "ApiSettings": {
    "BaseUrl": "https://webdownload"
  },
  "CorsUrls": {
    "AllowedOrigins": [
      "http://localhost",
      "https://localhost",
      "http://127.0.0.1",
      "https://127.0.0.1",
      "http://127.0.0.1:4200",
      "https://127.0.0.1:4200",
      "http://192.168.1.108:8090",
      "http://webfamily",
      "https://webfamily",
      "https://webdownload",
      "http://webdownload",
      "http://localhost:8090",
      "https://localhost:8090",
      "http://127.0.0.1:8090",
      "https://127.0.0.1:8090"
    ]
  },
  "Splitter": {
    "DemucsExecutablePath": "C:\\Tools\\demucs314\\Scripts\\demucs.exe",
    "ModelCacheFolder": "C:\\Tools\\demucs-models",
    "OutputFolder": "d:\\medias\\separated",
    "StandardModel": "htdemucs",
    "HighQualityModel": "htdemucs_ft",
    "Mp3Bitrate": "320k",
    "RpmMenu": "rpm",
    "RpmFolder": "musics\\rpm",
    "StandardQualityLabel": "Standard (faster)",
    "HighQualityLabel": "High (about 4 times slower)"
  },
  "VoiceSwap": {
    "ApplioFolder": "C:\\Tools\\Applio",
    "PythonExecutablePath": "",
    "ScriptName": "core.py",
    "Models": [
      {
        "Id": "me",
        "Name": "My voice",
        "PthPath": "C:\\Tools\\Applio\\logs\\myvoice\\myvoice.pth",
        "IndexPath": "C:\\Tools\\Applio\\logs\\myvoice\\added_myvoice.index",
        "DefaultPitch": 0
      }
    ],
    "OutputFolder": "d:\\medias\\voiceswap",
    "TempFolder": "",
    "F0Method": "rmvpe",
    "IndexRate": 0.5,
    "Protect": 0.33,
    "VolumeEnvelope": 1.0,
    "EmbedderModel": "contentvec",
    "SpeakerId": 0,
    "SplitAudio": true,
    "CleanAudio": false,
    "CleanStrength": 0.7,
    "F0Autotune": false,
    "F0AutotuneStrength": 1.0,
    "ExtraArgs": [],
    "FallbackToCpu": true,
    "InferenceTimeoutMinutes": 60,
    "MixFilterTemplate": "[0:a]aformat=sample_rates=44100:channel_layouts=stereo,volume={0}dB[m];[1:a]aformat=sample_rates=44100:channel_layouts=stereo,volume={1}dB[v];[m][v]amix=inputs=2:duration=first:dropout_transition=0:normalize=0,alimiter=limit=0.95[mix]",
    "MusicGainDb": 0,
    "VocalGainDb": 0,
    "MixOutputLabel": "mix",
    "Mp3Bitrate": "320k",
    "VideoAudioBitrate": "256k",
    "MixTrackTitle": "Voice swap",
    "KeepConvertedVoice": true,
    "MaxConcurrentJobs": 1
  },
  "Subtitle": {
    "StoragePath": "d:\\medias\\closecaption",
    "OutputPath": "d:\\medias\\closecaption\\translate",
    "MaxFileSizeBytes": 10485760
  },
  "Voiceover": {
    "IgnoreWords": [
      "[music]",
      "(music)",
      "[applause]",
      "(applause)",
      "[noise]",
      "(noise)",
      "[laughter]",
      "(laughter)",
      "[sighs]",
      "[clears throat]"
    ],
    "SrtFolder": "d:\\medias\\closecaption\\translate",
    "OutputFolder": "d:\\medias\\converted",
    "VideoExtensions": [ ".mp4", ".m4v", ".mov", ".mkv", ".webm" ],
    "SubtitleExtensions": [ ".srt", ".vtt" ],
    "DefaultVoice": "km-KH-PisethNeural",
    "Mp3Bitrate": "96k",
    "MaxSpeedUp": 2.0,
    "MaxBorrowSeconds": 1.0,
    "MaleVoice": "km-KH-PisethNeural",
    "FemaleVoice": "km-KH-SreymomNeural",
    "AnalysisSeconds": 30,
    "GenderThresholdHz": 165,
    "MaxConcurrentJobs": 1,
    "VoiceTrackTitle": "Khmer",
    "VoiceLanguageCode": "khm",
    "MakeVoiceTrackDefault": true,
    "MaxAdjustPercent": 25,
    "TtsSampleRate": 24000,
    "MaleBaselineHz": 120,
    "FemaleBaselineHz": 210,
    "MatchVoiceByDefault": true,
    "MinClipTempo": 0.5,
    "MinFilterTempo": 0.25,
    "MaxFilterTempo": 4.0
  },
  "YtDlp": {
    "ExecutablePath": "yt-dlp.exe",
    "ConfigLocation": "yt-dlp.conf",
    "OutputFileTemplate": "%(title)s [%(id)s].%(ext)s",
    "TitleLookupArgs": [ "--no-warnings", "--print filename", "--skip-download" ],
    "ListSubtitlesArgs": [ "--list-subs", "--skip-download", "--no-warnings" ],
    "CommonDownloadArgs": [ "--no-warnings" ],
    "AudioOnlyArgs": [ "-f bestaudio" ],
    "AudioChapterArgs": [ "--split-chapters" ],
    "AudioFormatArgsTemplate": "-x --audio-format {0}",
    "SubtitleArgsTemplate": "--sub-langs \"{0}\" --write-subs --write-auto-subs --convert-subs srt",
    "DragDropArgs": [
      {
        "Label": "Remux to MP4 container",
        "Arg": "--remux-video mp4"
      },
      {
        "Label": "Best video+audio merged",
        "Arg": "-f bestvideo+bestaudio/best"
      },
      {
        "Label": "Cap resolution at 1080p",
        "Arg": "-f \"bv*[height<=1080]+ba/b[height<=1080]\""
      },
      {
        "Label": "Force merged output to MP4",
        "Arg": "--merge-output-format mp4"
      },
      {
        "Label": "Embed chapters",
        "Arg": "--embed-chapters"
      },
      {
        "Label": "Embed metadata",
        "Arg": "--embed-metadata"
      },
      {
        "Label": "Embed thumbnail as cover art",
        "Arg": "--embed-thumbnail"
      },
      {
        "Label": "Only specific playlist items",
        "Arg": "--playlist-items 1-5"
      },
      {
        "Label": "Single video, ignore playlist",
        "Arg": "--no-playlist"
      },
      {
        "Label": "Limit download rate",
        "Arg": "--limit-rate 2M"
      },
      {
        "Label": "Retry count on network errors",
        "Arg": "--retries 10"
      }
    ],
    "FfmpegExecutablePath": "ffmpeg.exe",
    "EmbedSubtitleArgsTemplate": "-y -i \"{0}\" -i \"{1}\" -map 0 -map 1 -c:v copy -c:a copy -c:s {2} -disposition:s:0 default -metadata:s:s:0 language={4} -movflags +faststart \"{3}\"",
    "ComplexScriptLanguages": [ "km", "th" ],
    "HardsubFontByLanguage": {
      "km": "Moulpali",
      "th": "Leelawadee UI"
    },
    "HardsubFontDefault": "Arial",
    "FontsDirectory": ".",
    "HardsubEmbedArgsTemplate": "-y -i \"{0}\" -vf \"ass='{1}':fontsdir='{2}'\" -c:v libx264 -crf 22 -c:a aac -b:a 192k -movflags +faststart \"{3}\"",
    "LanguageCodeMap": {
      "en": "eng",
      "km": "khm",
      "th": "tha"
    },
    "EmbedSubtitleCodecByExtension": {
      ".mp4": "mov_text",
      ".m4v": "mov_text",
      ".mov": "mov_text",
      ".mkv": "srt",
      ".webm": "webvtt"
    },
    "EmbedSubtitleDefaultCodec": "srt",
    "SubtitleFileExtensions": [ ".srt", ".vtt", ".ass", ".ssa", ".sbv", ".ttml" ],
    "VideoFileExtensions": [ ".mp4", ".mkv", ".webm", ".mov", ".avi", ".flv", ".m4v" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "GoogleCloud": {
    "ApiKey": "",
    "CredentialsPath": ""
  }
}
